---
const heroFeatures = [
  {
    title: 'Quartermaster Review',
    body: 'Every feature gets an independent code review before it ships. The Quartermaster agent inspects the diff for test gaps, correctness risks, and code quality — no feature merges without a PASS.',
    code: `$ /dock
  ⠋ Spawning Quartermaster review agent...

  ┌─ Quartermaster Review ──────────────────┐
  │ Files changed: 6  (+142 / -38)          │
  │                                         │
  │  ✓ Test coverage: all new paths covered │
  │  ✓ No security issues detected          │
  │  ✓ Code quality: clean                  │
  │                                         │
  │  Verdict: PASS                          │
  └─────────────────────────────────────────┘

  ✓ Merged feature/add-search → main`,
  },
  {
    title: 'Parallel Agent Builds',
    body: 'Independent milestones are built simultaneously by worker agents — each with its own branch, tests, and commits. Results are merged and reviewed together. Same quality gate, faster builds.',
    code: `$ /sail add dashboard analytics

  Plan: 3 milestones

  ┌─ Building in parallel ──────────────────┐
  │                                         │
  │  agent-1 ██████████░░ milestone 1 (API) │
  │  agent-2 ████████░░░░ milestone 2 (UI)  │
  │                                         │
  │  waiting: milestone 3 (integration)     │
  └─────────────────────────────────────────┘`,
  },
];

const supportingFeatures = [
  {
    icon: 'anchor',
    title: 'One-Command Setup',
    body: 'Run <code>npx tiller-ai init</code> in any project. Tiller writes your CLAUDE.md, slash commands, and git hooks — then gets out of the way.',
  },
  {
    icon: 'compass',
    title: 'Slash Commands',
    body: 'Built-in <code>/sail</code>, <code>/scout</code>, <code>/anchor</code>, <code>/dock</code>, and <code>/recap</code> commands give Claude Code a coherent workflow vocabulary.',
  },
  {
    icon: 'wheel',
    title: 'Two Modes',
    body: '<strong>Simple mode</strong> for non-technical users who want outcomes. <strong>Detailed mode</strong> for developers who want to review every decision.',
  },
  {
    icon: 'shield',
    title: 'Safety Hooks',
    body: 'A secret-scanning hook blocks any tool write that would commit credentials or API keys. A post-write hook runs your formatter automatically.',
  },
  {
    icon: 'map',
    title: 'Codebase Map',
    body: 'The Cartographer agent maintains a living map of your project — so Claude stays oriented even as the codebase grows.',
  },
];
---

<section class="features" id="features" aria-labelledby="features-heading">
  <div class="container">
    <div class="section-header">
      <p class="section-eyebrow">What you get</p>
      <h2 id="features-heading" class="section-heading">
        A complete workflow,<br/>
        <em>not just a config file</em>
      </h2>
      <p class="section-subtitle">
        Tiller installs a coherent system of conventions so Claude Code
        knows how to work in your project from day one.
      </p>
    </div>

    <!-- Hero features -->
    <div class="hero-features">
      {heroFeatures.map(({ title, body, code }) => (
        <article class="hero-feature-card">
          <div class="hero-feature-text">
            <h3 class="hero-feature-title">{title}</h3>
            <p class="hero-feature-body">{body}</p>
          </div>
          <div class="hero-feature-code">
            <pre><code>{code}</code></pre>
          </div>
        </article>
      ))}
    </div>

    <!-- Supporting features -->
    <div class="supporting-grid">
      {supportingFeatures.map(({ icon, title, body }) => (
        <article class="feature-card">
          <div class={`feature-icon feature-icon--${icon}`} aria-hidden="true">
            {icon === 'anchor' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="5" r="2"/>
                <line x1="12" y1="7" x2="12" y2="22"/>
                <path d="M5 15l7 7 7-7"/>
                <path d="M5 12h14"/>
              </svg>
            )}
            {icon === 'compass' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
              </svg>
            )}
            {icon === 'wheel' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"/>
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="2" x2="12" y2="9"/>
                <line x1="12" y1="15" x2="12" y2="22"/>
                <line x1="2" y1="12" x2="9" y2="12"/>
                <line x1="15" y1="12" x2="22" y2="12"/>
                <line x1="4.93" y1="4.93" x2="9.17" y2="9.17"/>
                <line x1="14.83" y1="14.83" x2="19.07" y2="19.07"/>
                <line x1="14.83" y1="9.17" x2="19.07" y2="4.93"/>
                <line x1="4.93" y1="19.07" x2="9.17" y2="14.83"/>
              </svg>
            )}
            {icon === 'shield' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            )}
            {icon === 'map' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/>
                <line x1="8" y1="2" x2="8" y2="18"/>
                <line x1="16" y1="6" x2="16" y2="22"/>
              </svg>
            )}
          </div>
          <h3 class="feature-title">{title}</h3>
          <p class="feature-body" set:html={body}></p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .features {
    padding: var(--space-24) 0;
    background-color: var(--cream-100);
  }

  /* Section header */
  .section-header { text-align: center; margin-bottom: var(--space-16); }
  .section-eyebrow { display: inline-block; font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--teal-500); margin-bottom: var(--space-4); }
  .section-heading { font-family: var(--font-serif); font-size: clamp(var(--text-3xl), 4vw, var(--text-4xl)); font-weight: 700; line-height: 1.15; letter-spacing: -0.01em; color: var(--navy-900); margin-bottom: var(--space-4); }
  .section-heading em { font-style: italic; color: var(--teal-600); }
  .section-subtitle { font-size: var(--text-lg); color: var(--text-secondary); max-width: 520px; margin: 0 auto; line-height: 1.7; }

  /* Hero feature cards */
  .hero-features {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .hero-feature-card {
    background-color: var(--navy-800);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    transition: box-shadow var(--transition-base);
  }

  @media (min-width: 768px) {
    .hero-feature-card {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
      padding: var(--space-10);
    }
  }

  .hero-feature-card:hover {
    box-shadow: var(--shadow-lg);
  }

  .hero-feature-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-4);
  }

  .hero-feature-title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--cream-100);
  }

  .hero-feature-body {
    font-size: var(--text-base);
    color: var(--text-inverse-muted);
    line-height: 1.7;
  }

  .hero-feature-code {
    background-color: var(--navy-900);
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.08);
    overflow-x: auto;
  }

  .hero-feature-code pre {
    margin: 0;
    padding: var(--space-6);
    overflow-x: auto;
  }

  .hero-feature-code code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--cream-100);
    white-space: pre;
  }

  /* Supporting grid */
  .supporting-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 560px) {
    .supporting-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 900px) {
    .supporting-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Card styles */
  .feature-card {
    background-color: var(--white);
    border: 1px solid var(--cream-300);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    transition: box-shadow var(--transition-base), transform var(--transition-base);
  }
  .feature-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .feature-icon { width: 44px; height: 44px; border-radius: var(--radius-md); background-color: var(--navy-800); display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-5); color: var(--gold-300); }
  .feature-icon svg { width: 22px; height: 22px; }
  .feature-title { font-family: var(--font-serif); font-size: var(--text-xl); font-weight: 700; color: var(--navy-900); margin-bottom: var(--space-3); }
  .feature-body { font-size: var(--text-base); color: var(--text-secondary); line-height: 1.65; }
  .feature-body code { font-family: var(--font-mono); font-size: 0.875em; background-color: var(--cream-200); color: var(--navy-700); padding: 0.1em 0.35em; border-radius: 3px; }
  .feature-body strong { color: var(--navy-800); font-weight: 600; }
</style>
