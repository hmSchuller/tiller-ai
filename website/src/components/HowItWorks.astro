---
const steps = [
  {
    number: '01',
    label: 'Plan',
    title: 'Read context, then plan',
    body: 'Claude Code reads the codebase map and project config, then creates a feature branch and writes milestones. The map stays current as the project grows.',
    code: `$ /sail add search to the dashboard

  ✓ Read codebase-map.md
  ✓ Read .tiller.json + changelog
  ✓ Branch: feature/add-search
  ✓ Plan: 3 milestones — waiting for approval`,
    color: 'teal',
  },
  {
    number: '02',
    label: 'Build',
    title: 'Milestone by milestone',
    body: 'Each milestone includes implementation, tests, and a commit. Independent milestones run in parallel.',
    code: `  ✓ Milestone 1: search API endpoint
  ✓ Milestone 2: search UI component
  ⠋ Milestone 3: integration tests`,
    color: 'gold',
  },
  {
    number: '03',
    label: 'Review',
    title: 'Independent code review',
    body: 'The Quartermaster agent inspects every diff for test gaps, correctness risks, and code quality.',
    code: `  Quartermaster Review
  Files changed: 6  (+142 / -38)
  ✓ Tests: all paths covered
  ✓ Security: clean
  Verdict: PASS`,
    color: 'teal',
  },
  {
    number: '04',
    label: 'Ship',
    title: 'Merge and clean up',
    body: 'When review passes, /dock merges to main, updates the changelog, refreshes the codebase map, and cleans up the branch.',
    code: `$ /dock

  ✓ Merged feature/add-search → main
  ✓ Changelog updated
  ✓ Codebase map refreshed
  ✓ Branch cleaned up`,
    color: 'cream',
  },
];
---

<section class="how-it-works" id="how-it-works" aria-labelledby="hiw-heading">
  <!-- Background wave in -->
  <div class="section-wave-in" aria-hidden="true">
    <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0 60 C360 20 720 60 1080 20 C1260 0 1380 40 1440 20 L1440 0 L0 0 Z" fill="#faf7f0"/>
    </svg>
  </div>

  <div class="hiw-body">
    <div class="container">
      <div class="section-header">
        <p class="section-eyebrow">The development cycle</p>
        <h2 id="hiw-heading" class="section-heading">
          How it works
        </h2>
        <p class="section-subtitle">
          Every feature follows the same four-step cycle — keeping AI sessions
          predictable and your codebase clean.
        </p>
      </div>

      <div class="steps">
        {steps.map((step, i) => (
          <div class={`step step--${step.color}`}>
            <div class="step-inner">
              <div class="step-number-wrap">
                <span class="step-number">{step.number}</span>
                <span class="step-label">{step.label}</span>
              </div>
              <div class="step-content">
                <h3 class="step-title">{step.title}</h3>
                <p class="step-body">{step.body}</p>
              </div>
              <div class="step-code">
                <pre><code>{step.code}</code></pre>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Wave out -->
  <div class="section-wave-out" aria-hidden="true">
    <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0 0 C360 40 720 0 1080 40 C1260 60 1380 20 1440 40 L1440 60 L0 60 Z" fill="#faf7f0"/>
    </svg>
  </div>
</section>

<style>
  .how-it-works {
    background-color: var(--navy-800);
    color: var(--text-inverse);
  }

  .section-wave-in,
  .section-wave-out {
    line-height: 0;
  }

  .section-wave-in svg,
  .section-wave-out svg {
    display: block;
    width: 100%;
    height: 60px;
  }

  .hiw-body {
    padding: var(--space-20) 0;
  }

  /* Section header */
  .section-header {
    text-align: center;
    margin-bottom: var(--space-16);
  }

  .section-eyebrow {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-300);
    margin-bottom: var(--space-4);
  }

  .section-heading {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-3xl), 4vw, var(--text-4xl));
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--cream-100);
    margin-bottom: var(--space-4);
  }

  .section-subtitle {
    font-size: var(--text-lg);
    color: var(--text-inverse-muted);
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* Steps */
  .steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    max-width: 760px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .steps {
      grid-template-columns: 1fr 1fr;
      max-width: 100%;
    }
  }

  .step {
    position: relative;
    min-width: 0;
  }

  .step-inner {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition: background-color var(--transition-base);
    min-width: 0;
    overflow: hidden;
  }

  .step-inner:hover {
    background-color: rgba(255, 255, 255, 0.07);
  }

  .step-number-wrap {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .step-number {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 1;
  }

  .step--teal .step-number { color: var(--teal-300); }
  .step--gold .step-number { color: var(--gold-300); }
  .step--cream .step-number { color: var(--cream-200); }

  .step-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-inverse-muted);
    opacity: 0.7;
  }

  .step-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--cream-100);
    margin: 0;
  }

  .step-body {
    font-size: var(--text-base);
    color: var(--text-inverse-muted);
    line-height: 1.65;
    margin: 0;
  }

  .step-code {
    margin-top: auto;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .step-code pre {
    margin: 0;
    padding: var(--space-4);
  }

  .step-code code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--cream-200);
    white-space: pre;
  }
</style>
