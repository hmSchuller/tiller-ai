---
const personas = [
  {
    icon: 'zap',
    mode: 'simple',
    label: 'Solo Creator',
    hook: 'Move fast, stay clean',
    body: 'You describe what you want. Claude Code branches, builds, and commits — Tiller keeps the codebase clean.',
    bullets: [
      'Auto-branching & commits',
      'Changelog & codebase map maintained',
      'Secret scanning blocks leaked keys',
      'Quartermaster reviews before merge',
    ],
  },
  {
    icon: 'compass',
    mode: 'detailed',
    label: 'Solo Developer',
    hook: 'Stay in control of an AI that can outpace you',
    body: 'You approve plans, review every diff, inspect milestones. Claude Code works methodically — no surprises.',
    bullets: [
      'Milestone-by-milestone planning',
      'Quartermaster code review gate',
      'Compass tracks progress across sessions',
      'Full narration of every decision',
    ],
  },
  {
    icon: 'users',
    mode: 'detailed',
    label: 'Engineering Team',
    hook: 'Same workflow for every engineer\'s Claude Code',
    body: 'Shared conventions mean Claude Code works the same way across the team — consistent branches, commits, reviews.',
    bullets: [
      'Shared slash commands & hooks',
      'Consistent branch + commit conventions',
      'Independent code review on every feature',
      'Codebase map keeps Claude Code oriented',
    ],
  },
];
---

<section class="ways-to-work" id="ways-to-work" aria-labelledby="wtw-heading">
  <div class="container">
    <div class="section-header">
      <p class="section-eyebrow">Ways to work</p>
      <h2 id="wtw-heading" class="section-heading">
        Tiller fits how<br/>
        <em>you already work</em>
      </h2>
      <p class="section-subtitle">
        Whether you're moving fast or staying methodical, Tiller gives Claude Code
        the structure to work consistently in your project.
      </p>
    </div>

    <div class="persona-grid">
      {personas.map(({ icon, mode, label, hook, body, bullets }) => (
        <article class="persona-card">
          <div class="persona-icon" aria-hidden="true">
            {icon === 'zap' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
              </svg>
            )}
            {icon === 'compass' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
              </svg>
            )}
            {icon === 'users' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            )}
          </div>
          <h3 class="persona-label">{label}</h3>
          <span class={`mode-badge mode-badge--${mode}`}>Mode: {mode}</span>
          <p class="persona-hook">{hook}</p>
          <p class="persona-body">{body}</p>
          <ul class="persona-bullets">
            {bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <p class="coexistence-note">
      Switch anytime with <code>npx tiller-ai mode</code>. Both modes use the same quality gates.
    </p>
  </div>
</section>

<style>
  .ways-to-work {
    padding: var(--space-24) 0;
    background-color: var(--cream-100);
  }

  /* Section header */
  .section-header { text-align: center; margin-bottom: var(--space-16); }
  .section-eyebrow { display: inline-block; font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--teal-500); margin-bottom: var(--space-4); }
  .section-heading { font-family: var(--font-serif); font-size: clamp(var(--text-3xl), 4vw, var(--text-4xl)); font-weight: 700; line-height: 1.15; letter-spacing: -0.01em; color: var(--navy-900); margin-bottom: var(--space-4); }
  .section-heading em { font-style: italic; color: var(--teal-600); }
  .section-subtitle { font-size: var(--text-lg); color: var(--text-secondary); max-width: 520px; margin: 0 auto; line-height: 1.7; }

  /* Persona grid */
  .persona-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-10);
  }

  @media (min-width: 768px) {
    .persona-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 900px) {
    .persona-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Persona card */
  .persona-card {
    background-color: var(--white);
    border: 1px solid var(--cream-300);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    transition: box-shadow var(--transition-base), transform var(--transition-base);
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 900px) {
    .persona-card {
      padding: var(--space-8);
      min-height: 600px;
    }
  }

  .persona-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .persona-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background-color: var(--navy-800);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-3);
    color: var(--gold-300);
    flex-shrink: 0;
  }

  .persona-icon svg {
    width: 22px;
    height: 22px;
  }

  .persona-label {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--navy-900);
  }

  .mode-badge {
    align-self: flex-start;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2em 0.8em;
    border-radius: 999px;
    margin-bottom: var(--space-4);
  }

  .mode-badge--simple {
    background-color: var(--teal-100, #e6f4f1);
    color: var(--teal-600);
  }

  .mode-badge--detailed {
    background-color: var(--cream-200);
    color: var(--navy-700);
  }

  .persona-hook {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    font-weight: 600;
    font-style: italic;
    color: var(--teal-600);
    margin-bottom: var(--space-2);
    line-height: 1.4;
  }

  .persona-body {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: var(--space-4);
  }

  .persona-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .persona-bullets li {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    padding-left: var(--space-5);
    position: relative;
    line-height: 1.5;
  }

  .persona-bullets li::before {
    content: '·';
    position: absolute;
    left: var(--space-2);
    color: var(--teal-500);
    font-weight: 700;
  }

  /* Footer note */
  .coexistence-note {
    text-align: center;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .coexistence-note code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background-color: var(--cream-200);
    color: var(--navy-700);
    padding: 0.1em 0.35em;
    border-radius: 3px;
  }
</style>
