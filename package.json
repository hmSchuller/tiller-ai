{
  "name": "tiller-ai",
  "version": "0.6.0",
  "description": "Scaffold Claude Code projects with a structured vibe loop",
  "type": "module",
  "bin": {
    "tiller-ai": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "regen": "npm run build && npm link && tiller-ai upgrade --yes",
    "prepublish-check": "tsx scripts/prepublish-check.ts",
    "prepublishOnly": "npm run build && npm test && npm run prepublish-check"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "ai-workflow",
    "scaffold",
    "cli",
    "vibe-coding",
    "developer-tools",
    "code-generation",
    "project-scaffold"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hmSchuller/tiller-ai.git"
  },
  "homepage": "https://github.com/hmSchuller/tiller-ai#readme",
  "bugs": {
    "url": "https://github.com/hmSchuller/tiller-ai/issues"
  }
}
